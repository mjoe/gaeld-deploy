# Wird von scripts/init.sh nach .env kopiert; APP_KEY und DB_PASSWORD werden dabei erzeugt.
GAELD_VERSION=v3.8.28
INSTALL_OCR=false

APP_NAME=Gäld
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8080
APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_AVAILABLE_LOCALES=de,fr,it,en
APP_PORT=8080
# 127.0.0.1 = nur lokal/Reverse-Proxy auf demselben Host; 0.0.0.0 = im LAN erreichbar
APP_BIND=127.0.0.1

LOG_LEVEL=warning
TRUSTED_PROXIES=*

DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=gaeld
DB_USERNAME=gaeld
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_LIFETIME=120
# Bei HTTPS-Betrieb auf true setzen
SESSION_SECURE_COOKIE=false
SCOUT_DRIVER=database
PLUGINS_ENABLED=false
# Öffentliche Selbstregistrierung (/register). Standard: gesperrt
ALLOW_REGISTRATION=false

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=gaeld@example.ch
MAIL_FROM_NAME=Gäld

FEATURE_BANK_SYNC=false
FEATURE_AUTOMATION=false
FEATURE_MULTI_CURRENCY=false
FEATURE_API_ACCESS=true
FEATURE_AUTO_RECONCILIATION=false
FEATURE_RULE_ENGINE=false
FEATURE_ADVANCED_PERMISSIONS=false

TESSERACT_BINARY=/usr/bin/tesseract
TESSERACT_LANG=deu+fra+eng
